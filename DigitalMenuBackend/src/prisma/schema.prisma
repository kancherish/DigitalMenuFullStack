  generator client {
    provider = "prisma-client"
    output   = "../generated/prisma"
  }

  datasource db {
    provider = "postgresql"
  }

  enum NavStyle {
    tabs
    dropdown
  }

  enum headerLayoutN{
    banner
    minimal  
    split
  }

  enum logoShapeN {
    circle 
    rounded 
    square
  }

  enum overlayStyleN{
    gradient 
    solid 
    none
  }

  enum headingFontN{
    serif
    sans 
    display
  }

  enum headerAlignN{
    center
    left
  }

  enum headerSizeN{
    compact
    default
    large
  }

  enum categoryVariantN{
    pill
    underline
  }

  enum categorySizeN {
    sm
    md
    lg
  }

  enum itemSizeN {
    sm
    md
    lg
  }

  enum itemImagePositionN {
     left
     right
  }

  enum itemImageShapeN {
    rounded
    square
    circle
  }

  model RestaurantAdmin {
    id Int @id @default(autoincrement())
    publicId String  @unique @default(uuid())
    username String  @unique
    password String
    refreshToken String?
    restaurant Restaurant?
  }


  model Restaurant {
    id           Int        @id @default(autoincrement())
    publicId     String     @unique @default(uuid())
    name         String
    admin        RestaurantAdmin @relation(fields: [adminId], references: [publicId])
    adminId      String @unique 
    tagline      String?
    backgroundUrl String?
    logoUrl String?
    primaryColor String
    tabStyle     NavStyle
    roundness    String
    accentColor  String
    headerText   String @default("#ffffff")
    categories   Category[]
    showSearch   Boolean @default(false)                      
    showItemCount Boolean @default(false)        
    showDivider   Boolean @default(false)         
    stickyNav Boolean @default(false)     
    domain String?    
    defaultImageUrl String @default("https://order.pennentertainment.com/assets/img/png/default-menu-image-placeholder.png")
    showItemImage Boolean @default(false)
    headerLayout headerLayoutN @default(banner)
    logoShape    logoShapeN @default(circle)
    overlayStyle overlayStyleN @default(solid)
    overlayIntensity Float  @default(1)
    headingFont headingFontN @default(sans)
    headerAlign headerAlignN @default(center)
    headerSize  headerSizeN @default(compact)
    categoryVariant categoryVariantN @default(pill) 
    categorySize categorySizeN @default(sm)
    itemSize itemSizeN @default(sm)
    itemImagePosition itemImagePositionN @default(left)
    itemImageShape itemImageShapeN @default(square)
    currencySymbol String @default("₹")
    surfaceColor String @default("#ffffff")
    boardEnabled Boolean @default(false)
    boardText String @default("")
  }

  model Category {
    id            Int        @id @default(autoincrement())
    publicId      String     @unique @default(uuid())
    name          String     @unique
    restaurant_id String
    restaurant    Restaurant @relation(fields: [restaurant_id], references: [publicId], onDelete: Cascade)
    icon          String    @default ("Utensils")
    items         Item[]
  }

  model Item {
    id          Int       @id @default(autoincrement())
    publicId  String @unique @default(uuid())
    name        String   @unique
    description String?
    price       Float?    // null if item uses variants for pricing
    category    Category  @relation(fields: [category_id], references: [publicId], onDelete: Cascade)
    category_id String
    badges      String[] @default([])
    variants    Variant[]
    imageURL    String?
    available Boolean @default(true)
  }

  model Variant {
    id      Int    @id @default(autoincrement())
    publicId  String @unique @default(uuid())
    name    String
    price   Float
    item    Item   @relation(fields: [item_id], references: [publicId], onDelete: Cascade)
    item_id String
  }