server {
    listen 8080;
    server_name localhost;

    # === STATIC UPLOADS ===
    # Nginx serves images directly from disk — Express never sees these requests
    location /uploads {
        alias your_root_upload_path;
        
        # Don't run scripts from uploads (security)
        location ~ \.(php|js|sh)$ { return 403; }
        
        # Cache for 1 day during dev
        expires 1d;
        add_header Cache-Control "public";
        
        try_files $uri =404;
    }

    # === API & FRONTEND ===
    # Everything else goes to your Express app
    location / {
        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
